# Copiar como .env y reemplazar la IP por la del equipo que ejecuta el backend.
# En un Android físico conectado a la misma red Wi-Fi, NO usar localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Endpoint de prueba citado en documentación previa de Pizza Mya Web.
# Comprueba que siga existiendo; reemplázalo por una ruta GET real si cambió.
EXPO_PUBLIC_API_HEALTH_PATH=/api/health
